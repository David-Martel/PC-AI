# Auto detect text files and perform LF normalization
* text=auto

# PowerShell files
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Scripts
*.sh text eol=lf
*.bash text eol=lf

# Documentation
*.md text eol=crlf
*.txt text eol=crlf

# Configuration files
*.json text eol=crlf
# YAML and everything under .github/ stay LF in working copies too. With eol=crlf,
# Dependabot's checkout held CRLF files and its github-actions commits stored them
# as CRLF blobs (#226, #239, #240, #243, #244, #238), which #253 had to renormalize.
# LF working copies remove that conversion; YAML tooling on Windows reads LF fine.
*.yml text eol=lf
*.yaml text eol=lf
.github/** text eol=lf
*.xml text eol=crlf
*.config text eol=crlf

# Git files
.gitattributes text eol=crlf
.gitignore text eol=crlf
.editorconfig text eol=crlf

# Windows batch files
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary

# Preserve captured Milly evidence bytes and custody hashes verbatim.
Reports/milly-fleet-20261002/** -text -eol

# Preserve workload review evidence and the exact launch-source archive.
Reports/process-lasso-review/** -text -eol

# Preserve mixed-line-ending capture blobs; see docs/captured-evidence-custody.md.
Reports/input-stack-investigation-20260606/H3_intel_serialio_controllers.txt -text -eol
Reports/input-stack-investigation-20260606/H4_processlasso.txt -text -eol
Reports/input-stack-investigation-20260606/H5_io_cpu_load.txt -text -eol
Reports/input-stack-investigation-20260606/H7_vendor_services.txt -text -eol
Reports/onedrive-triage-20260509/27-stepC.txt -text -eol

# Published crate checksums and review patches bind exact upstream/source bytes.
vendor/candle-core-*/** -text -eol
vendor/patches/** -text -eol
Tests/Portable/candle-zip-security/fixtures/*.pt binary
# Preserve published Markdown hard-break spaces and unified-diff context bytes.
vendor/candle-core-*/src/tensor.rs whitespace=-blank-at-eol
vendor/candle-core-*/src/tensor_cat.rs whitespace=-blank-at-eol
vendor/candle-core-*/src/quantized/gguf_file.rs whitespace=-blank-at-eol
vendor/patches/** whitespace=-blank-at-eol,-blank-at-eof
