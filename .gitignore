# Build artifacts
# Use explicit paths + a whitelist so .NET build output (Native/Pcai*/bin, obj)
# stays ignored while Rust crate source directories (Native/pcai_core/*/src/bin/)
# remain tracked. Anonymous "bin/" at the repo root would also swallow Rust
# src/bin/ — hence the explicit !whitelist line.
/bin/
obj/
Native/PcaiChatTui/bin/
Native/PcaiNative/bin/
Native/PcaiServiceHost/bin/
Native/PcaiChatTui/obj/
Native/PcaiNative/obj/
Native/PcaiServiceHost/obj/
!Native/pcai_core/pcai_inference/src/bin/

# Claude project context is intentionally tracked for agent handoff.
*.dll
*.exe
*.pdb
Release/PowerShell/PC-AI/
Modules/Archive/

# PC-AI local artifacts (gitignored but searchable for LLM agents)
.pcai/

# Unified Build System output (.pcai/build/)
.pcai/build/artifacts/
.pcai/build/logs/
.pcai/build/packages/
!.pcai/.gitkeep

# Rust
target/
**/target-*/
**/*.rs.bk
Cargo.lock

# Rust build output logs (JSON structured output)
cargo_output*.json
**/cargo_output*.json
**/cargo_stdout.json

# Vendored CUDA/GPU kernels (use GitHub Releases for precompiled binaries)
**/vendor/
!**/vendor/.gitkeep

# Generated cargo configs (machine-specific, regenerated by CargoTools)
**/.cargo/config.toml
!**/.cargo/config.toml.template

