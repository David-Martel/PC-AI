{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PC-AI USB4 fleet desired configuration and inventory",
  "type": "object",
  "required": ["schemaVersion", "repository", "hosts", "payloads"],
  "properties": {
    "schemaVersion": {"const": 1},
    "repository": {"type": "string", "pattern": "^https://"},
    "purpose": {"type": "string"},
    "capabilities": {"type": "object"},
    "maintenance": {"type": "object"},
    "payloads": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["platform", "kind", "supportedArchitectures", "paths"],
        "properties": {
          "platform": {"enum": ["windows", "linux", "macos"]},
          "kind": {"enum": ["deployable", "templates-only"]},
          "supportedArchitectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["x86", "x86_64", "aarch64"]}},
          "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "qualification": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "platform", "architecture", "backend"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "platform": {"enum": ["windows", "linux", "macos"]},
          "architecture": {"enum": ["x86", "x86_64", "aarch64"]},
          "backend": {"type": "string", "minLength": 1},
          "policyPath": {"type": "string", "minLength": 1},
          "profileRevision": {"type": "integer", "minimum": 1},
          "role": {"enum": ["Peer", "Provider", "Consumer"]},
          "managementSshAlias": {"type": "string", "minLength": 1},
          "observed": {"type": "object"},
          "holds": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
