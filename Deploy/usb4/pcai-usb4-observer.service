[Unit]
Description=PC-AI enrolled USB4 observation (no network mutation)
After=network.target
ConditionPathExists=/etc/pcai-usb4/policy.json

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/pcai-usb4-agent observe /etc/pcai-usb4/policy.json
TimeoutStartSec=15s
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
