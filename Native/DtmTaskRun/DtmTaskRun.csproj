<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = Windows GUI subsystem. The OS never allocates a console for this
         process, so a scheduled task cannot flash a window. Children get
         CREATE_NO_WINDOW from ProcessStartInfo.CreateNoWindow. -->
    <OutputType>WinExe</OutputType>
    <!-- net8.0 matches the rest of Native/; RollForward lets a host that only has a
         newer runtime (dtm-p1gen9, CI) still run the same binary. -->
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>dtm-task-run</AssemblyName>
    <RootNamespace>DtmTaskRun</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Startup matters: this process wraps every scheduled run. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>false</TieredPGO>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <PublishReadyToRun>true</PublishReadyToRun>

    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Version>1.0.0</Version>
    <Description>Hidden launcher for Windows scheduled tasks that preserves child exit codes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DtmTaskRun.Tests" />
  </ItemGroup>

</Project>
