<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Optimize>true</Optimize>
    <BuildInParallel>true</BuildInParallel>
    <UseSharedCompilation>true</UseSharedCompilation>
    <TieredCompilation Condition="'$(Configuration)' == 'Release'">true</TieredCompilation>
    <TieredPGO Condition="'$(Configuration)' == 'Release'">true</TieredPGO>
    <ServerGarbageCollection Condition="'$(Configuration)' == 'Release'">true</ServerGarbageCollection>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Prefer32Bit>false</Prefer32Bit>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <ReadyToRunUseCrossgen2 Condition="'$(Configuration)' == 'Release'">true</ReadyToRunUseCrossgen2>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcaiChatTui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcaiNative\PcaiNative.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\PcaiNative\pcai_core_lib.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\PcaiNative\pcai_core_lib.dll')" />
    <None Include="..\PcaiNative\pcai_search.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\PcaiNative\pcai_search.dll')" />
    <None Include="..\PcaiNative\pcai_performance.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\PcaiNative\pcai_performance.dll')" />
    <None Include="..\PcaiNative\pcai_system.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\PcaiNative\pcai_system.dll')" />
  </ItemGroup>

</Project>
