<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target .NET 8 for modern performance with PowerShell 7 -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PcaiNative</RootNamespace>
    <AssemblyName>PcaiNative</AssemblyName>

    <!-- Enable nullable reference types for safer code -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Platform Configuration -->
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>

    <!-- Optimization Settings -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuildInParallel>true</BuildInParallel>
    <UseSharedCompilation>true</UseSharedCompilation>
    <TieredCompilation Condition="'$(Configuration)' == 'Release'">true</TieredCompilation>
    <TieredPGO Condition="'$(Configuration)' == 'Release'">true</TieredPGO>
    <ServerGarbageCollection Condition="'$(Configuration)' == 'Release'">true</ServerGarbageCollection>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Prefer32Bit>false</Prefer32Bit>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <ReadyToRunUseCrossgen2 Condition="'$(Configuration)' == 'Release'">true</ReadyToRunUseCrossgen2>

    <!-- Generate XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Version Info -->
    <Version>0.1.0</Version>
    <Authors>David Martel</Authors>
    <Description>C# P/Invoke wrapper for PC_AI native Rust libraries</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.4.6" />
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure Rust native libraries are copied to output directory when present -->
    <None Include="pcai_core_lib.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('pcai_core_lib.dll')" />
    <None Include="libpcai_core_lib.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('libpcai_core_lib.so')" />
    <None Include="libpcai_core_lib.dylib" CopyToOutputDirectory="PreserveNewest" Condition="Exists('libpcai_core_lib.dylib')" />
    <None Include="pcai_inference.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('pcai_inference.dll')" />
    <None Include="libpcai_inference.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('libpcai_inference.so')" />
    <None Include="libpcai_inference.dylib" CopyToOutputDirectory="PreserveNewest" Condition="Exists('libpcai_inference.dylib')" />
    <None Include="rust_functiongemma_runtime.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('rust_functiongemma_runtime.dll')" />
  </ItemGroup>

</Project>
