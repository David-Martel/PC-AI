 function Import-Profile {
+    <#
+    .SYNOPSIS
+    Reloads the profile in the caller's scope: . Import-Profile
+    .DESCRIPTION
+    Dot invocation preserves profile functions and variables after reload. Existing
+    shells keep their loaded definitions until this command is explicitly invoked.
+    #>
+    if ($MyInvocation.InvocationName -ne '.') {
+        throw 'Reload in the caller scope with: . Import-Profile'
+    }
+    if ($global:__MicrosoftPowerShellProfileLoading) {
+        throw 'Profile initialization is already in progress.'
+    }
+    if (-not (Test-Path -LiteralPath $PROFILE -PathType Leaf)) {
+        throw 'The current host profile file is unavailable.'
+    }
+    if ($script:ProfileHistoryWriterOwned) {
+        Close-JsonlAccelerator
+        $script:ProfileHistoryWriterOwned = $false
+    }
+    if ($script:ProfileExitSubscriptionId) {
+        Unregister-Event -SubscriptionId $script:ProfileExitSubscriptionId -ErrorAction SilentlyContinue
+        $script:ProfileExitSubscriptionId = $null
+    }
+    if ($script:ProfileExitJob) {
+        Remove-Job -Job $script:ProfileExitJob -Force -ErrorAction SilentlyContinue
+        $script:ProfileExitJob = $null
+    }
+    $global:__MicrosoftPowerShellProfileLoaded = $false
+    $global:__PrimaryProfilePipelineLoaded = $false
+    $global:__ProfileSystemBootstrapLoaded = $false
     Write-Host "Reloading PowerShell profile..." -ForegroundColor Yellow
     . $PROFILE
 }
